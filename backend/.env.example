# ── Server ─────────────────────────────────────────────────────────────────────
# Port the Express server listens on (Railway injects PORT automatically)
PORT=3001
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
# Full connection string (preferred) OR individual fields — use one style.
DATABASE_URL=postgresql://user:password@localhost:5432/taskmanager

# Individual fields (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskmanager
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your deployed frontend URL)
CORS_ORIGIN=http://localhost:5173

